# ============================================================
# CETWorkOverTime 配置模板
# 复制为 .env 后填写实际配置；不要提交真实凭据。
# ============================================================

# ============ 基础配置 ============
# 邮件文件存放目录（相对于项目根目录）
WORK_SUMMARY_DIR=工作总结
# 输出报告目录（相对于项目根目录）
OUTPUT_DIR=output
# 邮件文件扩展名
EMAIL_FILE_EXTENSION=.eml

# ============ 编码配置 ============
# 默认编码
DEFAULT_ENCODING=gb2312
# 备选编码列表（逗号分隔）
FALLBACK_ENCODINGS=utf-8,gbk,gb18030

# ============ 输出配置 ============
# 输出格式
OUTPUT_FORMAT=markdown
# 缓存文件名
CACHE_FILENAME=.process_cache.json

# ============ 日志配置 ============
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ IMAP 邮箱配置 ============
# 邮箱地址
EMAIL_USERNAME=your_email@example.com
# IMAP 授权码（开启 IMAP/SMTP 服务时生成的授权码，非登录密码）
EMAIL_PASSWORD=your_imap_auth_code
# IMAP 服务器地址
IMAP_SERVER=imap.exmail.qq.com
# IMAP 端口
IMAP_PORT=993
# 是否使用 SSL
IMAP_USE_SSL=true
# 邮箱文件夹（&XeVPXGXlX9c- 即"工作日志"文件夹，如需收件箱可设为 INBOX）
IMAP_MAILBOX=&XeVPXGXlX9c-
# 搜索邮件主题关键词
IMAP_SEARCH_SUBJECT=--工作日志
# 搜索最近多少天的邮件
IMAP_SEARCH_DAYS=365

# ============ SMTP 发信配置 ============
# SMTP 服务器地址（发送服务器）
SMTP_HOST=smtp.exmail.qq.com
# SMTP 端口
SMTP_PORT=465
# 是否使用 SSL（465 端口用 SSL，587 端口用 STARTTLS 则设为 false）
SMTP_USE_SSL=true
# 发件账号
SMTP_USERNAME=your_email@example.com
# SMTP 授权码（与 EMAIL_PASSWORD 相同，开启 SMTP 服务时生成的授权码）
SMTP_PASSWORD=your_smtp_auth_code
# 发件人显示地址（一般同 SMTP_USERNAME，留空则自动回退用 SMTP_USERNAME）
SMTP_FROM=your_email@example.com

# ============ MySQL 数据库配置 ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=cetworkovertime
DB_CHARSET=utf8mb4

# ============ 系统登录配置 ============
# TOTP 密钥 (必须是 Base32 编码，用于 2FA 登录，建议修改为您自己的私密字符串)
TOTP_SECRET=replace_with_base32_secret
# Session 加密密钥 (建议部署时修改为复杂的随机字符串)
SECRET_KEY=replace_with_a_long_random_secret
# Cookie 仅在 HTTPS 下传输（生产环境启用 HTTPS 后设为 true）
COOKIE_SECURE=false

# ============ 统计、调度和清理配置 ============
# 勤奋时间目标（小时）
DILIGENCE_TARGET_HOURS=36
# 定时抓取间隔（小时）
SCHEDULE_INTERVAL_HOURS=24
# 入库后是否删除本地 .eml 文件（true/false）
CLEANUP_EML_AFTER_SYNC=true
